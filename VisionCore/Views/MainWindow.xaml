<Window x:Class="VisionCore.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:cognex_controls="clr-namespace:Cognex.InSight.Web.Controls;assembly=Cognex.InSight.Web.Controls"
        xmlns:behaviors="clr-namespace:VisionCore.Views"
        xmlns:vm="clr-namespace:VisionCore.ViewModels"
        Title="FAPLUS Vision Professional" Height="900" Width="1400"
        Background="#F5F5F5" WindowStyle="None" WindowState="Maximized">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SmallIconBtnStyle" TargetType="ButtonBase">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileIconBtnStyle" TargetType="ButtonBase" BasedOn="{StaticResource SmallIconBtnStyle}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <!-- 토글 버튼: 켜져 있을 때 배경/테두리로 상태를 명확히 표시 (기존엔 아무 표시가 없었음) -->
        <Style x:Key="SmallToggleBtnStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F4E79"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4FA3E3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileToggleBtnStyle" TargetType="ToggleButton" BasedOn="{StaticResource SmallToggleBtnStyle}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <Style x:Key="OnlineStatusImageStyle" TargetType="Image">
            <Setter Property="Source" Value="/Resources/Offline_64.png"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter Property="Source" Value="/Resources/Online_64.png"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileOnlineStatusImageStyle" TargetType="Image" BasedOn="{StaticResource OnlineStatusImageStyle}">
            <Setter Property="Width" Value="16"/>
        </Style>

        <!-- Point 결과 카드 (썸네일 클릭 시 그 센서 디스플레이에 미리보기) -->
        <DataTemplate x:Key="PointResultCardTemplate">
            <Button Width="84" Margin="4" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Command="{Binding DataContext.PreviewImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <Border Width="78" Height="52" CornerRadius="3" BorderThickness="2" Background="#000000">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#444444"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOk}" Value="True">
                                        <Setter Property="BorderBrush" Value="LimeGreen"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOk}" Value="False">
                                        <Setter Property="BorderBrush" Value="IndianRed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding PointName}" Foreground="#AAAAAA" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <Border CornerRadius="8" Margin="0,2,0,0" Padding="8,1" HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#3A3A3A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOk}" Value="True">
                                        <Setter Property="Background" Value="#1B5E20"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOk}" Value="False">
                                        <Setter Property="Background" Value="#B71C1C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="대기"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOk}" Value="True">
                                            <Setter Property="Text" Value="OK"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOk}" Value="False">
                                            <Setter Property="Text" Value="NG"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- 센서 1개(타일 1개) 템플릿: 자유 배치(드래그 이동/모서리 리사이즈) -->
        <DataTemplate DataType="{x:Type vm:SensorSessionViewModel}">
            <Grid Background="Black">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="96"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.RowSpan="3" BorderBrush="#333333" BorderThickness="1"/>

                <!-- 타일 헤더 (배경 전체가 드래그 핸들, 버튼은 그 위에 올라와 클릭이 우선됨) -->
                <Grid Grid.Row="0">
                    <Thumb Background="#2D2D2D" Cursor="SizeAll" DragDelta="TileHeader_DragDelta">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="{TemplateBinding Background}" BorderBrush="#121212" BorderThickness="0,0,0,1"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                        <Image Style="{StaticResource TileOnlineStatusImageStyle}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding DisplayName}" Foreground="#DCDCDC" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- 실시간 조작: Trigger / Live / Online -->
                        <Button Command="{Binding TriggerCommand}" Style="{StaticResource TileIconBtnStyle}" ToolTip="Manual Trigger">
                            <Image Source="/Resources/Trigger_32.png" Width="16"/>
                        </Button>
                        <ToggleButton IsChecked="{Binding IsLive}" Style="{StaticResource TileToggleBtnStyle}" ToolTip="Live Mode">
                            <Image Source="/Resources/Live_32.png" Width="16"/>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsOnline}" Style="{StaticResource TileToggleBtnStyle}" ToolTip="ONLINE/OFFLINE Mode">
                            <Image Style="{StaticResource TileOnlineStatusImageStyle}"/>
                        </ToggleButton>

                        <Rectangle Width="1" Fill="#444444" Margin="4,8"/>

                        <!-- Job -->
                        <Button Command="{Binding OpenJobCommand}" Style="{StaticResource TileIconBtnStyle}" ToolTip="Open Job">
                            <Image Source="/Resources/JobOpen_32.png" Width="16"/>
                        </Button>
                        <Button Command="{Binding SaveJobCommand}" Style="{StaticResource TileIconBtnStyle}" ToolTip="Save Job">
                            <Image Source="/Resources/JobSave_32.png" Width="16"/>
                        </Button>

                        <Rectangle Width="1" Fill="#444444" Margin="4,8"/>

                        <!-- 표시 옵션: Graphics / Grid -->
                        <ToggleButton IsChecked="{Binding DisplayVM.IsGraphicVisible}" Style="{StaticResource TileToggleBtnStyle}" ToolTip="Show/Hide Graphics">
                            <Ellipse Width="10" Height="10" Stroke="#FF6666" StrokeThickness="1.5"/>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding DisplayVM.IsGridVisible}" Style="{StaticResource TileToggleBtnStyle}" ToolTip="Show/Hide Grid">
                            <Image Source="/Resources/Sheet_32.png" Width="16"/>
                        </ToggleButton>

                        <Rectangle Width="1" Fill="#444444" Margin="4,8"/>

                        <!-- 타일 제어: 전체화면 / 닫기 -->
                        <Button Click="MaximizeTile_Click" Style="{StaticResource TileIconBtnStyle}" ToolTip="Maximize / Restore">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="12" Height="12">
                                    <Path Stroke="#CCCCCC" StrokeThickness="1.3" Fill="Transparent">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="M1,1 L11,1 L11,11 L1,11 Z"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                                        <Setter Property="Data" Value="M4,1 L11,1 L11,8 M1,4 L8,4 L8,11 L1,11 Z"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button Command="{Binding DataContext.RemoveSensorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource TileIconBtnStyle}" ToolTip="Disconnect / Remove">
                            <Image Source="/Resources/Close_48.png" Width="14"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 영상/그리드 표시: Grid 모드는 오버레이가 아니라 화면 전환 방식 -->
                <Grid Grid.Row="1" Background="Black">
                    <wfi:WindowsFormsHost Visibility="{Binding DisplayVM.IsVideoVisible, Converter={StaticResource BoolToVis}}"
                                behaviors:InSightBehavior.SensorSource="{Binding Sensor}"
                                behaviors:InSightBehavior.IsOverlayVisible="{Binding DisplayVM.IsGraphicVisible}">
                        <cognex_controls:CvsDisplay/>
                    </wfi:WindowsFormsHost>

                    <wfi:WindowsFormsHost Visibility="{Binding DisplayVM.IsGridVisible, Converter={StaticResource BoolToVis}}"
                                  behaviors:InSightBehavior.SensorSource="{Binding Sensor}">
                        <cognex_controls:CvsSpreadsheet/>
                    </wfi:WindowsFormsHost>
                </Grid>

                <!-- Point별 최신 결과 + 이미지 (센서별로 구분되어 이 타일에 종속) -->
                <Border Grid.Row="2" Background="#121212" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource PointResultCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- 리사이즈 그립 -->
                <Thumb Grid.Row="0" Grid.RowSpan="3" Width="16" Height="16" Margin="0,0,1,1"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Path Data="M1,13 L13,1 M6,13 L13,6 M10,13 L13,10" Stroke="#888888" StrokeThickness="1.5"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Grid x:Name="tLayout_Main">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="180" MinHeight="30"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#121212" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- 로고 영역 (기존 유지) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <Image Source="/Resources/FAPLUS_Logo.jpg"
                   Height="42"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
                    </StackPanel>

                    <!-- 우측 장치 탐색 및 연결 제어 영역 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">

                        <Button Command="{Binding ScanDevicesCommand}"
                            Style="{StaticResource SmallIconBtnStyle}"
                            ToolTip="Search Devices (Camera/Emulator)">
                            <Image Source="/Resources/zoom-original.ico" Width="18" Opacity="0.9"/>
                        </Button>

                        <!-- 탐색된 장치 목록 선택 ComboBox -->
                        <ComboBox ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice}"
                      Width="180" Height="28"
                      Margin="4,0"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"
                      Background="#2D2D2D"
                      Foreground="Black"
                      BorderBrush="#444444"
                      DisplayMemberPath="DisplayName"
                      ToolTip="Select Discovered Device"/>

                        <Rectangle Width="1" Fill="#444444" Margin="8,15"/>

                        <!-- 선택한 장치를 타일로 추가 -->
                        <Button Command="{Binding ConnectCommand}" Style="{StaticResource SmallIconBtnStyle}" ToolTip="Add Selected Sensor">
                            <Image Source="/Resources/Run_48.png" Width="22" Opacity="0.9"/>
                        </Button>

                        <Rectangle Width="1" Fill="#444444" Margin="8,15"/>

                        <!-- 타일을 격자 형태로 재정렬 -->
                        <Button Command="{Binding ArrangeTilesCommand}" Style="{StaticResource SmallIconBtnStyle}" ToolTip="Arrange Tiles">
                            <Image Source="/Resources/SelectWindow1_32.png" Width="18" Opacity="0.9"/>
                        </Button>

                        <Rectangle Width="1" Fill="#444444" Margin="8,15"/>

                        <Button Command="{Binding OpenConfigCommand}"
                            Style="{StaticResource SmallIconBtnStyle}"
                            ToolTip="System Configuration">
                            <Image Source="/Resources/Setting_64.png" Width="18" Opacity="0.8"/>
                        </Button>

                        <Rectangle Width="1" Fill="#444444" Margin="8,15"/>

                        <!-- 프로그램 종료 버튼 (기존 유지) -->
                        <Button Command="{Binding CloseCommand}" Style="{StaticResource SmallIconBtnStyle}"
                    Background="#22C42B1C" ToolTip="Close Application">
                            <Image Source="/Resources/Close_48.png" Width="18"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 센서 타일 대시보드: 자유 배치(드래그 이동/리사이즈), 넘치면 스크롤 -->
            <ScrollViewer x:Name="SensorScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#0A0A0A">
                <ItemsControl ItemsSource="{Binding Sensors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            <Setter Property="Width" Value="{Binding Width}"/>
                            <Setter Property="Height" Value="{Binding Height}"/>
                            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </ScrollViewer>

            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  Background="#333333" ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

            <!-- 하단 로그 패널 -->
            <Border Grid.Row="3" Background="#1E1E1E" BorderBrush="#121212" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#252525" VerticalAlignment="Center">
                        <TextBlock Text="LOG MESSAGES" Foreground="#888888" FontSize="11" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding logger.LogMessages}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Background="#121212" BorderThickness="0" Foreground="#DCDCDC"
                 FontSize="12" FontFamily="Consolas">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="#555555" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{Binding LogColor}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
