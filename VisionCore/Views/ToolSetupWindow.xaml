<Window x:Class="VisionCore.Views.ToolSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VisionCore.Views"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="{Binding Title}" Height="900" Width="1600" MinHeight="500" MinWidth="1000"
        Background="#EEF0F3" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 오버레이 탭: Edit 셀을 포인트 블록별로 묶어서 표시 -->
        <CollectionViewSource x:Key="OverlayItemsView" Source="{Binding Overlay.Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Enter로 바로 적용 (기본은 포커스 잃을 때) -->
        <Style x:Key="ValueBox" TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <EventSetter Event="KeyDown" Handler="ValueBox_KeyDown"/>
        </Style>

        <Style x:Key="CollapseWhenNull" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 파라미터 1칸 (카드 안에서 가로로 여러 개 배치) -->
        <DataTemplate x:Key="ParamTemplate">
            <DockPanel Height="30" Margin="0,0,24,2" Background="Transparent"
                       MouseEnter="Param_ShowHelp" GotKeyboardFocus="Param_ShowHelp">
                <!-- 표시 파라미터 선택 모드: ★ = 평소에 보일 파라미터 -->
                <ToggleButton DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,2,0" Cursor="Hand"
                              IsChecked="{Binding IsKey}" ToolTip="★ = 평소에 표시할 파라미터 (같은 함수 툴 전체에 적용)"
                              Visibility="{Binding DataContext.SelectParamsMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <TextBlock x:Name="Star" Text="☆" FontSize="15" Foreground="#B0B0B0" Background="Transparent"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Star" Property="Text" Value="★"/>
                                    <Setter TargetName="Star" Property="Foreground" Value="#F0A800"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- 🔗 같은 함수 툴끼리 공용 셀로 연결 / 이 툴만 해제 -->
                <Button DockPanel.Dock="Right" Content="해제" Width="34" Height="22" Margin="4,0,0,0" FontSize="11"
                        Click="ParamUnlink_Click" ToolTip="이 툴만 공용 연결 해제 (현재 값을 상수로)"
                        Visibility="{Binding CanUnlink, Converter={StaticResource BoolToVis}}"/>
                <Button DockPanel.Dock="Right" Content="🔗" Width="26" Height="22" Margin="4,0,0,0"
                        Click="ParamLink_Click" ToolTip="같은 함수를 쓰는 다른 툴과 이 값을 공용으로 연결"
                        Visibility="{Binding CanLink, Converter={StaticResource BoolToVis}}"/>

            <Grid Width="390">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" ToolTip="{Binding LabelToolTip}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#333333"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                    <Setter Property="Foreground" Value="#D35400"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                    <Setter Property="Foreground" Value="#1F5FA8"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 참조/수식: 왼쪽 = 식(참조) 그대로 수정, 오른쪽 = 참조한 셀의 값 수정 (연결 유지) -->
                <TextBox Grid.Column="1" Style="{StaticResource ValueBox}" Text="{Binding Text}"
                         HorizontalContentAlignment="Left" Margin="0,0,4,0"
                         FontFamily="Consolas" Foreground="#1F5FA8" Background="#F3F6FA"
                         ToolTip="참조/수식 (Enter = 적용)"
                         Visibility="{Binding ShowExpressionBox, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Column="2" Style="{StaticResource ValueBox}" Text="{Binding LinkedValue}"
                         ToolTip="참조한 셀의 값 (Enter = 적용, 다른 툴과의 연결은 유지)"
                         Visibility="{Binding ShowLinkedValueBox, Converter={StaticResource BoolToVis}}"/>
                <!-- 참조 셀이 Button: 누르기 (예: Train Event → 모델 재등록) -->
                <Button Grid.Column="2" Height="24" Content="{Binding ButtonCaption}" FontWeight="Bold"
                        Background="#FFF4D6" BorderBrush="#E0A800" Click="ParamPress_Click"
                        ToolTip="참조한 버튼 셀을 누릅니다 (Train 이면 현재 이미지로 모델 다시 등록)"
                        Visibility="{Binding IsButtonRef, Converter={StaticResource BoolToVis}}"/>
                <!-- 트리거 인자가 버튼을 참조하지 않음: 버튼 셀 생성 + 연결 -->
                <Button Grid.Column="1" Width="80" Height="24" HorizontalAlignment="Right" Margin="0,0,4,0"
                        Content="버튼 만들기" FontSize="11" Click="ParamCreateButton_Click"
                        ToolTip="툴 오른쪽 빈 셀에 Button 을 만들고 이 인자를 그 셀로 연결 (이후 ▶ 로 실행)"
                        Visibility="{Binding CanCreateButton, Converter={StaticResource BoolToVis}}"/>

                <!-- 숫자: 범위 있으면 슬라이더 + 입력칸 -->
                <Slider Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                        Minimum="{Binding Min}" Maximum="{Binding Max}"
                        IsSnapToTickEnabled="{Binding IsInteger}" TickFrequency="1"
                        Value="{Binding SliderValue, Delay=300}"
                        Visibility="{Binding HasRange, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Column="2" Style="{StaticResource ValueBox}" Text="{Binding Text}"
                         Visibility="{Binding IsNumber, Converter={StaticResource BoolToVis}}"/>

                <!-- 선택형 -->
                <ComboBox Grid.Column="1" Grid.ColumnSpan="2" Height="24"
                          ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                          Visibility="{Binding IsEnum, Converter={StaticResource BoolToVis}}"/>

                <!-- 문자열 -->
                <TextBox Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ValueBox}" Text="{Binding Text}"
                         HorizontalContentAlignment="Left"
                         Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"/>
            </Grid>
            </DockPanel>
        </DataTemplate>

        <!-- 포인트 칩 -->
        <Style x:Key="PointChip" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" Width="118" Height="54" CornerRadius="4" Background="White"
                                BorderBrush="#D0D4DA" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#7FA7D9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#1F5FA8"/>
                                <Setter TargetName="Chip" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Chip" Property="Background" Value="#EAF2FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="150"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="130" MinHeight="60"/>
        </Grid.RowDefinitions>

        <!-- 상단: 안내 + 옵션 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar Width="80" Height="8" IsIndeterminate="True" Margin="0,0,12,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <ToggleButton Content="★ 표시 파라미터 선택" IsChecked="{Binding SelectParamsMode}" Height="26" Padding="8,0" Margin="0,0,14,0" FontWeight="Bold"
                              ToolTip="켜면 모든 파라미터 + ☆ 표시. ★ 누른 파라미터만 평소에 보임 (함수별 저장, ★ 없는 함수는 전부 표시)"/>
                <CheckBox Content="보조 툴 표시" IsChecked="{Binding ShowHelperTools}" VerticalAlignment="Center" Margin="0,0,14,0"
                          ToolTip="그래픽(PlotString 등), 다른 툴 출력을 입력으로 쓰는 후처리 툴(예: EdgeAI 마스크 → DetectBlobs)"/>
                <CheckBox Content="입력 이미지 인자 표시" IsChecked="{Binding ShowLockedParams}" VerticalAlignment="Center" Margin="0,0,14,0"
                          ToolTip="툴의 첫 인자(Image = 어떤 이미지를 검사할지)까지 표시"/>
                <Button Content="새로고침" Width="80" Height="26" Command="{Binding RefreshCommand}" Margin="0,0,14,0"/>
                <TextBlock Text="{Binding UnsavedText}" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#D35400"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UnsavedCount}" Value="0">
                                    <Setter Property="Foreground" Value="#888888"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="저장 (Ctrl+S)" Width="100" Height="26" Command="{Binding SaveCommand}"
                        ToolTip="센서에 로드된 잡에 덮어쓰기. 다른 이름으로 저장은 타일의 [Save As]."/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="① 포인트를 고르고  ② 아래 카드에서 값을 바꾸면 센서에 바로 반영됩니다." FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                <TextBlock Text="슬라이더 / Enter / 콤보 선택 즉시 적용 · 바뀐 항목은 주황색 · Ctrl+S = 센서 잡에 저장" Foreground="#777777" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ① 포인트 칩 -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint}"
                 ItemContainerStyle="{StaticResource PointChip}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,4">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUsed}" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 왼쪽 색 막대: OK 초록 / NG 빨강 / 미사용 회색 -->
                        <Border CornerRadius="3,0,0,3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#C0392B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result}" Value="OK">
                                            <Setter Property="Background" Value="#27AE60"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Result}" Value="">
                                            <Setter Property="Background" Value="#BBBBBB"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="7,4,4,4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Result}" FontWeight="Bold" FontSize="11" Foreground="#555555"/>
                                <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="13"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#555555" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#888888"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TabControl Grid.Row="2" x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged" Background="Transparent" Padding="0,4,0,0">
        <TabItem Header="  툴 파라미터  ">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="5*" MinWidth="420"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="280" MinWidth="180"/>
            </Grid.ColumnDefinitions>

        <!-- 이미지 + ROI 편집 -->
        <Border Grid.Column="0" Background="White" BorderBrush="#D0D4DA" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,6,8,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="맞춤" Width="44" Height="24" Click="FitImage_Click" Margin="0,0,6,0"
                                ToolTip="화면 배율 초기화 (표시만 바뀌고 검사에는 영향 없음)"/>
                        <Button Content="촬영" Width="56" Height="24" Command="{Binding TriggerCommand}" Margin="0,0,6,0"
                                ToolTip="Manual Trigger 후 새 이미지 표시"/>
                        <Button Content="이미지 갱신" Width="76" Height="24" Command="{Binding RefreshImageCommand}"
                                ToolTip="센서의 마지막 검사 이미지와 기준 위치 값을 다시 읽음"/>
                    </StackPanel>
                    <TextBlock Text="검사 영역" FontWeight="SemiBold" Foreground="#444444" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Foreground="#777777" FontSize="11" Margin="10,4" TextWrapping="Wrap"
                           Text="ROI 드래그 = 이동 · □ = 크기 · ● = 회전 · 방향키 = 1px 이동(Shift 10px) · 놓으면 센서 반영&#x0a;화살표 = 엣지 스캔 방향 · 휠 = 확대 · 오른쪽 드래그 = 화면 이동 (배율은 표시만, 검사 영향 없음)"/>
                <local:RoiCanvas x:Name="RoiView" Source="{Binding Image}" Rois="{Binding Rois}" SelectedRoi="{Binding SelectedRoi}"/>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- ② 선택한 포인트의 툴 카드 -->
        <Border Grid.Column="2" Background="White" BorderBrush="#D0D4DA" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ToolSummary}" FontWeight="SemiBold" Foreground="#1F5FA8" Margin="12,8,12,4"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tools}" Margin="8,0,8,8" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Margin="0,4" PreviewMouseLeftButtonDown="ToolCard_Select">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#E1E4E8"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Background" Value="#FAFBFC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="Orange"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Background" Value="#FFFBF3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Expander IsExpanded="{Binding IsExpanded}" Padding="10,2,10,8">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal" Margin="4,4" ToolTip="{Binding FunctionTip}">
                                                <!-- 쉬운 이름(굵게) + 원래 함수 이름(회색) + 하는 일 한 줄 -->
                                                <TextBlock Text="{Binding FriendlyName}" Tag="{Binding FriendlyName}" Style="{StaticResource CollapseWhenNull}"
                                                           FontWeight="Bold" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Cell.FunctionName}" Foreground="#888888" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FunctionTip}" Tag="{Binding FunctionTip}" Style="{StaticResource CollapseWhenNull}"
                                                           Foreground="#666666" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <Border Background="#E8ECF1" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Cell.Location}" FontSize="11" Foreground="#555555"/>
                                                </Border>
                                                <Border Background="#DDEFE0" CornerRadius="3" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding Cell.AffectsResult, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="포인트 판정(F)/결과(G) 셀이 참조하는 툴 - 이 툴 결과가 OK/NG에 영향을 줌">
                                                    <TextBlock Text="판정" FontSize="11" Foreground="#1E7B34"/>
                                                </Border>
                                                <Border Background="#FBE5D6" CornerRadius="3" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsHelper, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="보조" FontSize="11" Foreground="#A04000"/>
                                                </Border>
                                                <TextBlock Text="⚠" Foreground="#E67E22" FontSize="14" Margin="8,0,0,0"
                                                           Tag="{Binding Warning}" Style="{StaticResource CollapseWhenNull}" ToolTip="{Binding Warning}"/>
                                            </StackPanel>
                                        </Expander.Header>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Warning}" Tag="{Binding Warning}" Style="{StaticResource CollapseWhenNull}"
                                                       Foreground="#E67E22" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Sections}" IsTabStop="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="#1F5FA8" Margin="0,0,0,4"/>
                                                            <ItemsControl ItemsSource="{Binding Params}" ItemTemplate="{StaticResource ParamTemplate}" IsTabStop="False">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- 설명 패널: 마우스를 올리거나 입력칸을 클릭한 파라미터 -->
        <Border Grid.Column="4" Background="White" BorderBrush="#D0D4DA" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="설명" FontWeight="SemiBold" Foreground="#444444" Margin="12,8,12,4"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,12">
                    <Grid>
                        <TextBlock Text="파라미터에 마우스를 올리면 설명이 여기에 표시됩니다." Foreground="#999999" TextWrapping="Wrap"
                                   Tag="{Binding HelpParam}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HelpParam}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel DataContext="{Binding HelpParam}">
                            <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding HelpTitle}" Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,10"/>
                            <!-- 한 줄 쉬운 설명 -->
                            <Border Background="#FFF8E1" BorderBrush="#F0C36D" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,10"
                                    Visibility="{Binding HasEasyTip, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding EasyTip}" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding HelpKorean}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,0,0,10"
                                       Visibility="{Binding HasHelpKorean, Converter={StaticResource BoolToVis}}"/>
                            <Border Background="#F4F6F8" CornerRadius="3" Padding="8,6" Margin="0,0,0,10">
                                <TextBlock Text="{Binding HelpFacts}" TextWrapping="Wrap" Foreground="#333333" LineHeight="18"/>
                            </Border>
                            <TextBlock Text="도움말 원문 (영어)" Foreground="#888888" FontSize="11" Margin="0,0,0,2"
                                       Tag="{Binding HelpEnglish}" Style="{StaticResource CollapseWhenNull}"/>
                            <TextBlock Text="{Binding HelpEnglish}" TextWrapping="Wrap" Foreground="#666666" FontSize="11"
                                       Tag="{Binding HelpEnglish}" Style="{StaticResource CollapseWhenNull}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
        </Grid>
        </TabItem>

        <!-- 오버레이 / 레이아웃: 잡의 모든 Edit 그래픽 셀(EditPoint 등)을 모아 이미지 위에서 편집 -->
        <TabItem Header="  오버레이 / 레이아웃  " DataContext="{Binding Overlay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="180"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="300" MinWidth="180"/>
                </Grid.ColumnDefinitions>

                <!-- Edit 셀 목록 (포인트 블록별) -->
                <Border Grid.Column="0" Background="White" BorderBrush="#D0D4DA" BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="10,6,8,4">
                            <Button DockPanel.Dock="Right" Content="새로고침" Width="64" Height="22" Command="{Binding ReloadCommand}"/>
                            <TextBlock Text="Edit 그래픽 셀" FontWeight="SemiBold" Foreground="#444444" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Foreground="#777777" FontSize="11" Margin="10,0,8,4" TextWrapping="Wrap"/>
                        <ListBox ItemsSource="{Binding Source={StaticResource OverlayItemsView}}" SelectedItem="{Binding SelectedItem}"
                                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#1F5FA8" Margin="4,8,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LinkedSummary}" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Caption}" Tag="{Binding Caption}" Style="{StaticResource CollapseWhenNull}" Foreground="#555555" FontSize="11"/>
                                        <TextBlock Text="{Binding ValueText}" Foreground="#888888" FontSize="11" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                <!-- 이미지 + 도형 편집 (놓을 때마다 센서 반영, 연결 그래픽은 같이 움직임) -->
                <Border Grid.Column="2" Background="White" BorderBrush="#D0D4DA" BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="10,6,8,6">
                            <Button DockPanel.Dock="Right" Content="이미지 갱신" Width="76" Height="24" Click="OverlayReloadImage_Click"
                                    ToolTip="센서의 마지막 검사 이미지와 그래픽을 다시 읽음"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0"
                                        ToolTip="화면에 보이는 그래픽 글자(PlotString 등) 크기 배율. 메인 디스플레이에도 적용, 잡에는 영향 없음.&#x0a;잡의 실제 글자 크기는 오른쪽 목록의 Font Size 칸에서 수정">
                                <TextBlock Text="글자 표시" VerticalAlignment="Center" Foreground="#555555" Margin="0,0,6,0"/>
                                <Slider Width="120" Minimum="0.3" Maximum="10" Value="{Binding TextScale, Delay=150}" VerticalAlignment="Center"
                                        SmallChange="0.1" LargeChange="0.5"/>
                                <TextBlock Text="{Binding TextScaleText}" Width="34" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="놓으면 센서에 바로 반영 · 연결된 그래픽(PlotString 등)은 드래그 중 같이 움직이고, 놓으면 실제 위치로 맞춰짐"
                                       Foreground="#555555" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <wfi:WindowsFormsHost x:Name="OverlayHost"/>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                <!-- 선택한 셀 정보 + 연결된 셀 -->
                <Border Grid.Column="4" Background="White" BorderBrush="#D0D4DA" BorderThickness="1" CornerRadius="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8,12,12">
                        <StackPanel DataContext="{Binding SelectedItem}">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Group}" Foreground="#888888" FontSize="11" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Caption}" Tag="{Binding Caption}" Style="{StaticResource CollapseWhenNull}" Margin="0,4,0,0"/>
                            <Border Background="#F4F6F8" CornerRadius="3" Padding="8,6" Margin="0,10,0,10">
                                <TextBlock Text="{Binding ValueText}" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="{Binding LinkedSummary}" FontWeight="SemiBold" Foreground="#1F5FA8" Margin="0,0,0,4"/>
                            <TextBlock Text="이 셀을 참조해서 그려지는 그래픽 - 점을 옮기면 같이 움직입니다." Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Linked}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E1E4E8" BorderThickness="0,0,0,1" Padding="0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                            Visibility="{Binding HasFontSize, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Font Size" VerticalAlignment="Center" Foreground="#1F5FA8" Margin="0,0,6,0"/>
                                                    <TextBox Width="60" Style="{StaticResource ValueBox}" Text="{Binding FontSize}"
                                                             ToolTip="잡의 실제 글자 크기 (Enter = 센서에 적용)"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </TabItem>

        <!-- 캘리브레이션: 조그 단계별 캡처 → 계수(a,c,b,d) 자동 계산. 축 방향/부호는 계수에 들어가므로 설정 불필요 -->
        <TabItem Header="  캘리브레이션  " DataContext="{Binding Align}">
            <Border Background="White" BorderBrush="#D0D4DA" BorderThickness="1" CornerRadius="4">
                <DockPanel Margin="12,8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="새로고침" Width="70" Height="24" Command="{Binding ReloadCommand}"/>
                        <Button DockPanel.Dock="Right" Content="촬영" Width="70" Height="24" Margin="0,0,6,0" Command="{Binding TriggerCommand}"/>
                        <TextBlock Text="{Binding Summary}" Foreground="#777777" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="캘리브레이션 블록을 찾지 못했습니다 ('PosX' / 'PosY' 라벨 헤더 행 기준)." Foreground="#C0392B" Margin="0,4"
                               Visibility="{Binding NoCalibration, Converter={StaticResource BoolToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasCalibration, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="1. 로봇을 단계별 위치로 옮기고 → 촬영(또는 PLC 트리거) → [캡처]. 이동량은 로봇 좌표 부호 그대로 입력 (X 단계는 X만, Y 단계는 Y만)."
                                       Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,2" TextBlock.FontWeight="SemiBold" TextBlock.Foreground="#1F5FA8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="단계"/><TextBlock Grid.Column="1" Text="로봇 X (mm)"/><TextBlock Grid.Column="2" Text="로봇 Y (mm)"/><TextBlock Grid.Column="3" Text="로봇 θ (°)"/>
                                <TextBlock Grid.Column="4" Text="캡처 X (px)"/><TextBlock Grid.Column="5" Text="캡처 Y (px)"/><TextBlock Grid.Column="6" Text="캡처 θ"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding CalSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource ValueBox}" Text="{Binding JogX}"
                                                     Visibility="{Binding HasJogXY, Converter={StaticResource BoolToVis}}" ToolTip="-30 ~ 30, Enter = 적용"/>
                                            <TextBox Grid.Column="2" Margin="0,0,8,0" Style="{StaticResource ValueBox}" Text="{Binding JogY}"
                                                     Visibility="{Binding HasJogXY, Converter={StaticResource BoolToVis}}" ToolTip="-30 ~ 30, Enter = 적용"/>
                                            <TextBox Grid.Column="3" Margin="0,0,8,0" Style="{StaticResource ValueBox}" Text="{Binding JogT}"
                                                     Visibility="{Binding HasJogT, Converter={StaticResource BoolToVis}}" ToolTip="-30 ~ 30, Enter = 적용 (0 = θ 보정 안 함)"/>
                                            <TextBlock Grid.Column="4" Text="{Binding CapX}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding CapY}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding CapT}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                            <Button Grid.Column="7" Content="캡처" Height="24" Command="{Binding CaptureCommand}"
                                                    ToolTip="마지막 검사 결과의 1번 포인트 좌표를 이 단계로 저장"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="2. 계수 점검" FontWeight="SemiBold" Margin="0,14,0,4"/>
                            <Border Background="#F4F6F8" CornerRadius="3" Padding="8,6">
                                <TextBlock Text="{Binding CalCheck}" FontFamily="Consolas" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CalCheckBad}" Value="True">
                                                    <Setter Property="Foreground" Value="#C0392B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Coefs}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Cells}">
                                            <TextBlock Text="{Binding Name}" Width="120" Foreground="#555555"/>
                                            <TextBlock Text="{Binding X}" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="3. 현재 포인트 보정값 (원점은 [원점 등록] 탭의 포인트별 원점)" FontWeight="SemiBold" Margin="0,14,0,4"/>
                            <Grid TextBlock.FontWeight="SemiBold" TextBlock.Foreground="#1F5FA8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="X"/><TextBlock Grid.Column="2" Text="Y"/><TextBlock Grid.Column="3" Text="θ"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding LiveRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding Cells}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="#555555"/>
                                            <TextBlock Grid.Column="1" Text="{Binding X}" FontFamily="Consolas"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Y}" FontFamily="Consolas"/>
                                            <TextBlock Grid.Column="3" Text="{Binding T}" FontFamily="Consolas"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </TabItem>

        <!-- 원점 등록: 포인트별 기준 좌표 (Setup 표 헤더 행의 'OrgX' 라벨 기준) -->
        <TabItem Header="  원점 등록  " DataContext="{Binding Align}">
            <Border Background="White" BorderBrush="#D0D4DA" BorderThickness="1" CornerRadius="4">
                <DockPanel Margin="12,8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="새로고침" Width="70" Height="24" Command="{Binding ReloadCommand}"/>
                        <Button DockPanel.Dock="Right" Content="촬영" Width="70" Height="24" Margin="0,0,6,0" Command="{Binding TriggerCommand}"/>
                        <TextBlock Text="로봇을 기준 위치에 두고 해당 포인트를 검사한 뒤 [등록] → 그 포인트의 마지막 검사 좌표가 원점이 됨. 끝나면 Ctrl+S 저장."
                                   Foreground="#555555" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="포인트별 원점 표를 찾지 못했습니다 (Setup 표 헤더 행의 'OrgX' / 'OrgY' / 'OrgT' 라벨 기준)." Foreground="#C0392B" Margin="0,4"
                               Visibility="{Binding NoOriginTable, Converter={StaticResource BoolToVis}}"/>
                    <Grid DockPanel.Dock="Top" TextBlock.FontWeight="SemiBold" TextBlock.Foreground="#1F5FA8" Margin="0,0,0,2"
                          Visibility="{Binding HasOriginTable, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/><ColumnDefinition Width="160"/><ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="포인트"/><TextBlock Grid.Column="1" Text="이름"/><TextBlock Grid.Column="2" Text="Pos"/>
                        <TextBlock Grid.Column="3" Text="현재 X"/><TextBlock Grid.Column="4" Text="현재 Y"/><TextBlock Grid.Column="5" Text="현재 θ"/>
                        <TextBlock Grid.Column="6" Text="원점 X"/><TextBlock Grid.Column="7" Text="원점 Y"/><TextBlock Grid.Column="8" Text="원점 θ"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasOriginTable, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Origins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNow}" Value="True">
                                                        <Setter Property="Background" Value="#FFF6D5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/><ColumnDefinition Width="160"/><ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Code}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Pos}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding CurX}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding CurY}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding CurT}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding OrgX}" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="7" Text="{Binding OrgY}" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="8" Text="{Binding OrgT}" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Grid.Column="9" Content="등록" Height="24" Command="{Binding RegisterCommand}"
                                                    ToolTip="현재 X/Y/θ (이 포인트의 마지막 검사 좌표)를 원점으로 저장"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </TabItem>

        <!-- 데이터 맵: PLC로 보낼 값 정의 ('DATA MAP' 라벨 아래 슬롯 → FormatOutputBuffer 셀) -->
        <TabItem Header="  데이터 맵  " DataContext="{Binding Align}">
            <Border Background="White" BorderBrush="#D0D4DA" BorderThickness="1" CornerRadius="4">
                <DockPanel Margin="12,8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="새로고침" Width="70" Height="24" Command="{Binding ReloadCommand}"/>
                        <TextBlock Text="{Binding OutputInfo}" Foreground="#555555" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Foreground="#777777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="소스 = 셀 참조 또는 식 (예: $L$49 보정 X, $M$49 보정 Y, $N$49 보정 θ, J10 결과). 출력 = 소스 × 배율, 에러면 0. Enter = 센서에 적용."/>
                    <TextBlock DockPanel.Dock="Top" Text="데이터 맵을 찾지 못했습니다 ('DATA MAP' 헤더 행의 'Name' / 'Source' / 'Scale' / 'Out' 라벨 기준)." Foreground="#C0392B" Margin="0,4"
                               Visibility="{Binding NoDataMap, Converter={StaticResource BoolToVis}}"/>
                    <Grid DockPanel.Dock="Top" TextBlock.FontWeight="SemiBold" TextBlock.Foreground="#1F5FA8" Margin="0,0,0,2"
                          Visibility="{Binding HasDataMap, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/><ColumnDefinition Width="160"/><ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="80"/><ColumnDefinition Width="110"/><ColumnDefinition Width="50"/><ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="No"/><TextBlock Grid.Column="1" Text="이름"/><TextBlock Grid.Column="2" Text="소스"/>
                        <TextBlock Grid.Column="3" Text="배율"/><TextBlock Grid.Column="4" Text="출력"/><TextBlock Grid.Column="5" Text="유효"/><TextBlock Grid.Column="6" Text="PLC"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasDataMap, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding DataSlots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/><ColumnDefinition Width="160"/><ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="110"/><ColumnDefinition Width="50"/><ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding No}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource ValueBox}" HorizontalContentAlignment="Left" Text="{Binding Name}"/>
                                        <TextBox Grid.Column="2" Margin="0,0,8,0" Style="{StaticResource ValueBox}" HorizontalContentAlignment="Left" Text="{Binding Source}" FontFamily="Consolas"/>
                                        <TextBox Grid.Column="3" Margin="0,0,8,0" Style="{StaticResource ValueBox}" Text="{Binding Scale}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Out}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Valid}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Plc}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS"/>

        <!-- 변경 기록 (최신이 위, 긴 메시지는 줄바꿈) -->
        <Border Grid.Row="4" Background="White" BorderBrush="#D0D4DA" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,4,6,2">
                    <Button DockPanel.Dock="Right" Content="지우기" Command="{Binding ClearLogCommand}" Padding="8,0" Height="20" FontSize="11"/>
                    <TextBlock Text="변경 기록" FontWeight="SemiBold" Foreground="#444444" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox ItemsSource="{Binding Logs}" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,1">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Foreground="#888888" Width="60"/>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#333333"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Foreground" Value="#C0392B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
