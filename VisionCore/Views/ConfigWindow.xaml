<Window x:Class="VisionCore.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration" Height="620" Width="460" MinHeight="420" MinWidth="380"
        Background="#1E1E1E" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="LimeGreen"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="12" Background="#1E1E1E" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#252525" MouseLeftButtonDown="TitleBar_MouseDown">
                <DockPanel Margin="20,0">
                    <TextBlock Text="CONFIGURATION" Foreground="#AAAAAA" VerticalAlignment="Center"
                               FontWeight="Bold" FontSize="11"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" Foreground="#666666" BorderThickness="0" Cursor="Hand"
                            Click="Close_Click" FontSize="18" Width="30"/>
                </DockPanel>
            </Border>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,10,10,0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border" Margin="0,0,10,0" Padding="15,8"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2">
                                        <ContentPresenter x:Name="ContentSite" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#888888"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="LimeGreen"/>
                                            <Setter Property="Panel.ZIndex" Value="100"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="NETWORK">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="15,20,15,0">
                        <StackPanel>
                            <TextBlock Text="NETWORK SETTINGS" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock Text="IP ADDRESS" Style="{StaticResource InputLabel}"/>
                            <TextBox Text="{Binding Settings.IP, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="PORT NUMBER" Style="{StaticResource InputLabel}"/>
                            <TextBox Text="{Binding Settings.Port, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="ADMIN USER" Style="{StaticResource InputLabel}"/>
                            <TextBox Text="{Binding Settings.User, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="PASSWORD" Style="{StaticResource InputLabel}"/>
                            <TextBox Text="{Binding Settings.Password, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="POINTS">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="15,20,15,0">
                        <StackPanel>
                            <TextBlock Text="INSPECTION POINT SETTINGS" Style="{StaticResource HeaderLabel}"/>

                            <TextBlock Text="POINT COUNT" Style="{StaticResource InputLabel}"/>
                            <TextBox Text="{Binding Settings.PointCount, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="RESULT CELL (OK/NG 판정 결과)" Style="{StaticResource InputLabel}"/>
                            <TextBox Text="{Binding Settings.CellResult, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="CURRENT POINT NUMBER CELL (PLC가 현재 Point 번호를 쓰는 셀)" Style="{StaticResource InputLabel}"/>
                            <TextBox Text="{Binding Settings.CellPointNumber, UpdateSourceTrigger=PropertyChanged}"/>

                            <Rectangle Height="1" Fill="#333333" Margin="0,4,0,15"/>

                            <TextBlock Text="CUSTOM FIELDS (필요한 값을 이름·셀 위치로 직접 추가)" Style="{StaticResource InputLabel}" Margin="2,0,0,8"/>

                            <ItemsControl ItemsSource="{Binding Settings.CustomFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#252525" CornerRadius="6" Margin="0,0,0,8" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBox Grid.Column="0" Margin="0,0,6,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="필드 이름 (자유 입력)"/>
                                                <TextBox Grid.Column="1" Margin="0" Text="{Binding CellLocation, UpdateSourceTrigger=PropertyChanged}" ToolTip="셀 위치 (예: A0)"/>

                                                <Button Grid.Column="2" Content="✕" Width="24" Height="24" Margin="6,0,0,0"
                                                        Background="Transparent" Foreground="#888888" BorderThickness="0" Cursor="Hand"
                                                        Command="{Binding DataContext.RemoveCustomFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="+ ADD FIELD" Command="{Binding AddCustomFieldCommand}"
                                    Height="30" Margin="0,4,0,20" Background="#252525" Foreground="LimeGreen"
                                    BorderThickness="1" BorderBrush="LimeGreen" Cursor="Hand"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="STORAGE">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="15,20,15,0">
                        <StackPanel>
                            <TextBlock Text="IMAGE STORAGE" Style="{StaticResource HeaderLabel}"/>

                            <TextBlock Text="SAVE PATH" Style="{StaticResource InputLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,6,15" IsReadOnly="True"
                                         Text="{Binding Settings.SaveRootPath, Mode=OneWay}"/>
                                <Button Grid.Column="1" Content="찾아보기" Command="{Binding BrowseSavePathCommand}"
                                        Height="34" Margin="0,0,0,15" Background="#3D3D3D" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            </Grid>

                            <TextBlock Text="AUTO DELETE (디스크 사용률 %)" Style="{StaticResource InputLabel}"/>
                            <TextBox Text="{Binding Settings.DiskLimitPercent, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="이 사용률을 넘으면 가장 오래된 날짜의 이미지부터 자동 삭제합니다. (0 = 사용 안 함, 50~95)"
                                       Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,15"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="#252525">
                <Button Content="SAVE SETTINGS" Command="{Binding SaveCommand}"
                        Width="220" Height="36" Background="#3D3D3D" Foreground="White"
                        FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <Thumb Grid.Row="0" Grid.RowSpan="3" Width="16" Height="16" Margin="0,0,2,2"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta" Background="Transparent">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Path Data="M1,13 L13,1 M6,13 L13,6 M10,13 L13,10" Stroke="#666666" StrokeThickness="1.5"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>